{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "timezone": "Europe/Paris",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "7 days",
  "semanticCommitType": "ci",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Release tools pinned in the workflow (npx -p package@version)",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["-p (?<depName>@?[a-z0-9/-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Release tools are updated together, by hand: they only run after the merge, the tests don't check them",
      "matchPackageNames": ["semantic-release", "@semantic-release/**", "conventional-changelog-conventionalcommits"],
      "groupName": "release tools",
      "automerge": false
    },
    {
      "description": "Version 10 breaks semantic-release's release notes",
      "matchPackageNames": ["conventional-changelog-conventionalcommits"],
      "allowedVersions": "<10"
    }
  ]
}
